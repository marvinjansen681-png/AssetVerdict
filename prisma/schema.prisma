generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  deals Deal[]
}

model Deal {
  id                 String  @id @default(cuid())
  userId             String
  user               User    @relation(fields: [userId], references: [id])
  name               String
  propertyType       String?
  investmentStrategy String? @default("commercial")
  address            String?
  city               String?
  notes              String?
  currency           String  @default("ZAR")

  // Acquisition
  askingPrice      Float?
  purchasePrice    Float?
  marketValue      Float?
  transferBondCost Float?
  renovationCost   Float?
  sourcingFee      Float?
  agentCommission  Float?
  wantToSell       Boolean @default(false)
  saleYear         Int?

  // Property Details
  erfNumber          String?
  erfSize            Float?
  propertyZoning     String?
  floorSize          Float?
  bedrooms           Int?
  bathrooms          Int?
  garages            Int?
  numUnits           Int?    @default(1)
  yearBuilt          Int?
  ratesAccountNumber String?
  titleDeedNumber    String?
  isSectionalTitle   Boolean @default(false)
  unitNumber         String?
  schemeName         String?
  schemeLevy         Float?

  // Other Inputs / Enterprise
  incomeTaxRate         Float? @default(27)
  capitalGainsTaxRate   Float? @default(22)
  capitalGrowthRate     Float? @default(3)
  rentalGrowthRate      Float? @default(8)
  costInflation         Float? @default(5)
  sustainableGrowthRate Float? @default(5)
  discountRate          Float? @default(10)
  realGrowthFactor      Float? @default(10)
  occupationFactor      Float? @default(10)
  marketCapRate         Float? @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financeSources    FinanceSource[]
  cashflowInputs    CashflowInputs?
  capexItems        CapexItem[]
  renovationItems   RenovationItem[]
  propertyValuation PropertyValuation?
  dealSuburbs       DealSuburb[]

  @@index([userId])
}

model FinanceSource {
  id              String @id @default(cuid())
  dealId          String
  deal            Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  sourceType      String
  ltvMode         String @default("percent")
  ltvValue        Float?
  loanAmount      Float?
  interestRate    Float?
  termYears       Int?   @default(15)
  repaymentAmount Float?
  order           Int    @default(0)

  @@index([dealId])
}

model CashflowInputs {
  id     String @id @default(cuid())
  dealId String @unique
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  // Revenue (monthly)
  monthlyRent      Float?
  occupancyRate    Float? @default(88)
  additionalIncome Float? @default(0)
  recoveries       Float? @default(0)

  // Expenses (monthly)
  managementFeeMode    String @default("percent")
  managementFeeValue   Float? @default(15)
  maintenanceCostMode  String @default("percent")
  maintenanceCostValue Float? @default(5)
  levies               Float? @default(0)
  ratesAndTaxes        Float?
  insurance            Float?
  waterSewerage        Float?
  securityCleaning     Float?
  electricity          Float?
  badDebtsPct          Float? @default(5)

  // STR (Short-Term Rental)
  nightlyRate       Float?
  avgOccupiedNights Int?   @default(200)
  platformFeesPct   Float? @default(15)

  // Student / Multi-Let (HMO)
  billsIncluded     Boolean @default(false)
  academicYearWeeks Int?    @default(42)
  pricePerRoom      Float?

  // Student Accommodation — room mix (NSFAS-aware)
  singleRoomCount      Int?   @default(0)
  singleRoomRent       Float? @default(0)
  singleRoomNsfasBeds  Int?   @default(0)
  sharingRoomCount     Int?   @default(0)
  sharingBedsPerRoom   Int?   @default(2)
  sharingRoomRent      Float? @default(0)
  sharingRoomNsfasBeds Int?   @default(0)
  nsfasCycleMonths     Int?   @default(10)
  privateCycleMonths   Int?   @default(12)

  // Fix & Flip
  holdingPeriodMonths Int?   @default(6)
  expectedSalePrice   Float?
  holdingCostPerMonth Float? @default(0)

  // Instalment Sale Agreement
  instalmentAmount Float?
  instalmentTerm   Int?   @default(240)
  instalmentRate   Float?
}

model RenovationItem {
  id          String @id @default(cuid())
  dealId      String
  deal        Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  category    String
  description String
  budgeted    Float  @default(0)
  quoted      Float?
  status      String @default("Not Started")
  order       Int    @default(0)

  @@index([dealId])
}

model CapexItem {
  id     String  @id @default(cuid())
  dealId String
  deal   Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  label  String
  amount Float
  color  String?

  @@index([dealId])
}

// ─────────────────────────────────────────────────────────────
// Area Analysis — Tier 1: Property-level valuation (AVM report)
// ─────────────────────────────────────────────────────────────
model PropertyValuation {
  id     String @id @default(cuid())
  dealId String @unique
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  // Source
  reportDate   DateTime?
  sgCode       String?
  reportSource String    @default("TPN Property Valuation Report")

  // Property Characteristics
  propertyDescription String?
  extentSqm           Float?
  zoning              String?
  buildingSizeSqm     Float?
  bedroomsReported    Int?
  bathroomsReported   Int?
  garagesReported     Int?
  yearBuiltReported   Int?

  // AVM
  estimatedValue      Float?
  valueConfidenceLow  Float?
  valueConfidenceHigh Float?
  valuationConfidence String? // e.g. "High" / "Medium" / "Low"
  pricePerSqm         Float?

  // Owner / buyer-seller signal
  currentOwnerSince DateTime?
  ownerAgeBand      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions PropertyTransaction[]
  bonds        BondRecord[]
  comparables  ComparableSale[]

  @@index([dealId])
}

model PropertyTransaction {
  id                  String            @id @default(cuid())
  propertyValuationId String
  propertyValuation   PropertyValuation @relation(fields: [propertyValuationId], references: [id], onDelete: Cascade)

  transferDate  DateTime?
  purchasePrice Float?
  buyerName     String?
  sellerName    String?
  order         Int       @default(0)

  @@index([propertyValuationId])
}

model BondRecord {
  id                  String            @id @default(cuid())
  propertyValuationId String
  propertyValuation   PropertyValuation @relation(fields: [propertyValuationId], references: [id], onDelete: Cascade)

  registrationDate DateTime?
  bondAmount       Float?
  bondHolder       String?
  bondType         String? // e.g. "First Bond", "Further Bond"
  order            Int       @default(0)

  @@index([propertyValuationId])
}

model ComparableSale {
  id                  String            @id @default(cuid())
  propertyValuationId String
  propertyValuation   PropertyValuation @relation(fields: [propertyValuationId], references: [id], onDelete: Cascade)

  address         String?
  sgCode          String?
  saleDate        DateTime?
  salePrice       Float?
  extentSqm       Float?
  buildingSizeSqm Float?
  pricePerSqm     Float?
  distanceKm      Float?
  order           Int       @default(0)

  @@index([propertyValuationId])
}

// ─────────────────────────────────────────────────────────────
// Area Analysis — Tier 2 & 3: Suburb / Province market intelligence
// ─────────────────────────────────────────────────────────────
model SuburbProfile {
  id     String @id @default(cuid())
  userId String

  // Identity
  suburbName   String
  city         String?
  province     String?
  reportType   String // "suburb" | "multiple_suburbs" | "province"
  reportDate   DateTime?
  reportYear   Int?
  reportSource String    @default("TPN Investor Report")
  notes        String?

  // Rental Payment Index (suburb-level)
  paidOnTimePct           Float?
  gracePeriodPct          Float?
  paidLatePct             Float?
  partialPaymentPct       Float?
  didNotPayPct            Float?
  goodStandingPct         Float?
  provinceGoodStandingPct Float?
  nationalGoodStandingPct Float?

  // Residential Yield
  stGrossYield       Float?
  stEffectiveYield   Float?
  fhGrossYield       Float?
  fhEffectiveYield   Float?
  nationalGrossYield Float?

  // Rental Price Trends — Sectional Title (ST)
  stSmallBedLow  Float? // <2Bed
  stSmallBedAvg  Float?
  stSmallBedHigh Float?
  st2BedLow      Float?
  st2BedAvg      Float?
  st2BedHigh     Float?
  stLargeBedLow  Float? // >2Bed
  stLargeBedAvg  Float?
  stLargeBedHigh Float?
  stRentalTrend  String? // ">10%Up" | "Up" | "None" | "Down" | ">10%Down"

  // Rental Price Trends — Freehold (FH)
  fhSmallBedLow  Float? // <3Bed
  fhSmallBedAvg  Float?
  fhSmallBedHigh Float?
  fh3BedLow      Float?
  fh3BedAvg      Float?
  fh3BedHigh     Float?
  fhLargeBedLow  Float? // >3Bed
  fhLargeBedAvg  Float?
  fhLargeBedHigh Float?
  fhRentalTrend  String?

  // Property Transactions / Investment activity
  stAvgPurchasePrice    Float?
  fhAvgPurchasePrice    Float?
  stTransactionVolume   Int?
  fhTransactionVolume   Int?
  investmentPropertyPct Float?

  // Demographics
  formalSectorPct          Float?
  unemployedPct            Float?
  incomeMiddleBandPct      Float? // R76k - R307k p.a.
  incomeHighBandPct        Float? // R307k+ p.a.
  age17to25Pct             Float?
  age26to40Pct             Float?
  age41to60Pct             Float?
  largeHouseholdPct        Float? // 6+ persons
  singlePersonHouseholdPct Float?

  // Province / National benchmarks (Tier 3)
  provinceSTGrossYield  Float?
  provinceFHGrossYield  Float?
  provinceST2BedAvgRent Float?
  provinceFH3BedAvgRent Float?
  provinceSTLargeBedAvg Float?
  provinceFHLargeBedAvg Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealSuburbs DealSuburb[]

  @@index([userId])
  @@index([suburbName])
}

model DealSuburb {
  id              String        @id @default(cuid())
  dealId          String
  deal            Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  suburbProfileId String
  suburbProfile   SuburbProfile @relation(fields: [suburbProfileId], references: [id], onDelete: Cascade)
  isPrimary       Boolean       @default(true)
  createdAt       DateTime      @default(now())

  @@unique([dealId, suburbProfileId])
  @@index([dealId])
  @@index([suburbProfileId])
}
