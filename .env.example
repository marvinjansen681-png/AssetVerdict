# Pooled connection used by the app at runtime (e.g. Supabase transaction
# pooler, port 6543, with pgbouncer=true). If you're on a plain single Postgres
# instance (not pooled), DATABASE_URL and DIRECT_URL can be the same value.
DATABASE_URL=postgresql://user:password@host:6543/dbname?pgbouncer=true&connection_limit=5&pool_timeout=20&sslmode=require

# Direct (non-pooled) connection used only for running migrations
# (e.g. Supabase session pooler, port 5432, or your DB's direct host).
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# Optional — enables the "Show Mentor's Comments" AI feature. Without it, the
# feature shows a friendly error instead of failing the build.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
